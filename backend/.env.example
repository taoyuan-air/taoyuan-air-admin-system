PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taoyuan_air
DB_USER=
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=taoyuan-air-admin
JWT_AUDIENCE=taoyuan-air-admin-web
UPLOAD_DIR=./uploads
# Inject INITIAL_ADMIN_PASSWORD only for a new administrator via a secret manager.

