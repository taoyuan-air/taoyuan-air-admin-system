SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSPHRASE=
SFTP_REMOTE_BASE=/data/taoyuan-air/uploads
